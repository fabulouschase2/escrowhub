# ---- EscrowHub backend configuration ----
# Copy to .env (or set in your deployment environment). All optional in dev;
# JWT_SECRET is REQUIRED in production.

# Bind address of the HTTP server
HOST=0.0.0.0
PORT=8080

# Solana network
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com

# Session signing secret — generate with: openssl rand -hex 32
# Rotating this invalidates every session.
JWT_SECRET=change-me-to-a-64-char-random-hex-string

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# SQLite database file (use a mounted volume in production)
DATABASE_PATH=escrowhub.db

# Escrow authority keypair file (solana-keygen JSON byte array).
# Created on first start if missing. BACK THIS FILE UP — losing it means
# losing control of deposited funds. In real production use an audited
# on-chain escrow program with PDAs instead of a server-held key.
ESCROW_KEYPAIR_PATH=escrow-authority.json

# Optional platform fee wallet pubkey
# FEE_WALLET=
